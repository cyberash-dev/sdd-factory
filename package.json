{
  "name": "sdd-factory",
  "version": "0.1.0",
  "description": "Spec-driven multi-agent software factory on Mozaik",
  "main": "dist/cli.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "factory": "node --env-file-if-exists=.env --import tsx src/cli.ts"
  },
  "license": "MIT",
  "type": "module",
  "private": "true",
  "devDependencies": {
    "@types/node": "26.6.6",
    "agent-sdd": "2.1.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@mozaik-ai/cloud-sdk": "0.1.3",
    "@mozaik-ai/core": "4.1.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  }
}
